# Backend service configuration. Copy to backend/.env and fill in API keys.

# --- Database (matches root .env / docker-compose defaults) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=text2sql
DB_USER=text2sql
DB_PASSWORD=text2sql

# --- Schema extraction script scope (backend/scripts/schema_extraction/02_build_schema_index.py) ---
SCHEMAS_TO_INCLUDE=public
SAMPLE_ROWS_PER_TABLE=3
TABLE_ALLOWLIST=
AUTO_EXPAND_FK_NEIGHBORS=true

# --- LLM providers ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Retrieval / generation knobs ---
RETRIEVAL_DENSE_TOP_K=30
RETRIEVAL_KEYWORD_TOP_K=30
RETRIEVAL_RERANK_TOP_K=10
RERANKER_MODEL=BAAI/bge-reranker-base
MAX_REPAIR_RETRIES=3
EXECUTION_ROW_LIMIT=200
EXECUTION_STATEMENT_TIMEOUT_MS=5000

# --- API server ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173
